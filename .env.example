# Copy this file to .env.local and fill in your own Supabase project values.
# Find both of these in Supabase: Project Settings > API.
# Leave them blank/unset to run the app in local-only mode (no account,
# scores saved to the browser via localStorage instead).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
